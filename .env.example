# --- PIDE Engine ---
LOG_LEVEL=INFO
PATTERNS_CONFIG=config/patterns.yaml
SCORING_CONFIG=config/scoring.yaml
EXEMPLARS_PATH=data/attack_exemplars.json
AUDIT_LOG=logs/audit.jsonl

# --- LLM Provider API Keys (all optional) ---
# Any provider without a key will run in deterministic simulation mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Custom OpenAI-compatible provider (xAI, Together, OpenRouter, Ollama, etc.) ---
# Use the "Custom" pill in the UI to plug in any OpenAI-compatible endpoint not listed above.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
